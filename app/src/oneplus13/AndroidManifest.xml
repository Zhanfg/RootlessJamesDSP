<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- OnePlus 13 system-AIDL controller: remove rootless-only capabilities. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW"
        tools:node="remove" />

    <!-- Updates are delivered with the matching systemless module, not by the
         generic RootlessJamesDSP self-updater. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION"
        tools:node="remove" />

    <uses-permission
        android:name="moe.shizuku.manager.permission.API_V23"
        tools:node="remove" />

    <queries>
        <package
            android:name="moe.shizuku.privileged.api"
            tools:node="remove" />
    </queries>

    <application tools:node="merge">
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            tools:node="remove" />

        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            tools:node="remove" />

        <activity
            android:name=".activity.OnboardingActivity"
            tools:node="remove" />

        <service
            android:name=".service.RootlessAudioProcessorService"
            tools:node="remove" />

        <service
            android:name="me.timschneeberger.rootlessjamesdsp.flavor.updates.SessionInstallerService"
            tools:node="remove" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            tools:node="remove" />
    </application>
</manifest>
